# pay-gateway 服务端环境变量模板（仅服务端使用，不进 Skill 包、不提交 git）
# 复制本文件为 .env 并填入你的真实值。

# ===== 批次 A：服务标识与域名 =====
# A1. 你的公网 HTTPS 域名（部署 gateway 并配好解析+证书后对外暴露的地址）
GATEWAY_BASE=https://pay.koneryan.com

# A2. 支付宝 serviceId（来自支付宝 AI 付「服务管理」注册服务，形如 API_xxxx）
#     当前网关对所有路径用同一个 SERVICE_ID；如需 3 个 skill 各一个 serviceId，联系改造。
SERVICE_ID=API_xxxxxxxx

# A3. 卖家支付宝用户 ID（2088 开头的 16 位，来自支付宝商家中心）
SELLER_ID=2088123456789012

# ===== 批次 B：密钥（安全敏感，仅服务端，绝不进 Skill 包/日志/仓库）=====
# B1. 应用私钥（支付宝开放平台密钥工具生成，整段 PEM）
ALIPAY_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----

# B2. 支付宝公钥（支付宝开放平台提供，整段 PEM）
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----

# ===== 端口 =====
PORT=3000
